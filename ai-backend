  ai-backend mtp <on|off|tokens|draft>  Configure Multi-Token Prediction speculative decoding
  ai-backend probe [url]                 Streaming decode-speed A/B probe (dev/probe_mtp.py); baseline vs MTP
  ai-backend tune [model]                Auto-tune context, KV cache, and MTP draft tokens for max throughput
  ai-backend draft <path|auto|off>      Set/clear the dspark draft model for speedup
  ai-backend gpu-layers <n|auto>        Set or clear GPU offload layer count
  ai-backend gpus [all|<devs>|auto|split <p>]   Select GPUs (single vs multi-GPU split)
  ai-backend serve                      Run llama-server with auto context sizing

Examples:
  ai-backend tune                       # auto-tune active model for hardware & max speed
  ai-backend use qwen3.8                # use Qwen3.8-27B (Unsloth GGUF)
  ai-backend cache q4_0                 # 4-bit KV cache quantization (prevents VRAM spillover)
  ai-backend use qwen3.8-2.4t           # use Qwen3.8-2.4T-A95B
  ai-backend mode thinking              # recommended Qwen3.8 thinking parameters
  ai-backend mtp on                     # enable MTP speculative decoding
  ai-backend ctx 262144                 # full 256K context for Qwen3.8
  ai-backend gpus all                   # spread a >1-GPU model across every card
""")

def main():
    prog = os.path.basename(sys.argv[0])
    
    if prog in ("llama-server-wrapper.sh", "llama-wrapper"):
        cmd_serve()
        return

    args = sys.argv[1:]
    if not args:
        cmd_status()
        return

    cmd = args[0]

    if cmd in ("-h", "--help", "help"):
        print_usage()
        return
    elif cmd in ("status", "info"):
        cmd_status()
    elif cmd in ("list", "ls", "models"):
        cmd_list()
    elif cmd in ("serve", "server", "run", "wrapper"):
        cmd_serve()
    elif cmd in ("download", "get", "gguf"):
        target = args[1] if len(args) > 1 else None
        if not target:
            print("Usage: ai-backend download <hf_url_or_repo_or_uri>")
            sys.exit(1)
        dest = download_hf_target(target)
        print(f"Model downloaded: {dest}")
        apply_model_path(dest)
    elif cmd in ("use", "set", "switch", "local", "llama", "qwen3", "qwen3-6", "qwen3-30", "qwen3.8", "qwen3.8-27b", "qwen3.8-2.4t", "gemma4"):
        target = args[1] if len(args) > 1 else (cmd if cmd not in ("use", "set", "switch", "local", "llama") else None)
        cmd_use(target)
    elif cmd == "auto":
        cmd_auto()
    elif cmd == "ctx":
        cmd_ctx(args[1] if len(args) > 1 else None)
    elif cmd in ("cache", "kv-cache", "ctx-quant", "cache-type", "quant"):
        cmd_cache_quant(args[1] if len(args) > 1 else None)
    elif cmd in ("draft", "dspark"):
        cmd_draft(args[1] if len(args) > 1 else None)
    elif cmd in ("mtp", "spec"):
        extra = args[2] if len(args) > 2 else None
        cmd_mtp(args[1] if len(args) > 1 else None, extra)
    elif cmd in ("tune", "auto-tune", "tune-mtp", "optimize"):
        cmd_tune(args[1] if len(args) > 1 else None)
    elif cmd in ("probe", "speed", "benchmark"):
        cmd_probe(args[1] if len(args) > 1 else None)
    elif cmd in ("mode", "preset"):
        cmd_mode(args[1] if len(args) > 1 else None)
    elif cmd in ("yarn", "rope"):
        cmd_yarn(args[1] if len(args) > 1 else None)
    elif cmd in ("reasoning", "reasoning-effort"):
        cmd_reasoning(args[1] if len(args) > 1 else None)
    elif cmd in ("gpu-layers", "gpulayers"):
        cmd_gpu_layers(args[1] if len(args) > 1 else None)
    elif cmd in ("gpus", "gpu", "tensor-split"):
        # `gpus split <props>` pins an explicit tensor split; everything else selects devices.
        if len(args) > 1 and args[1] == "split":
            props = args[2] if len(args) > 2 else None
            if not props:
                print("Usage: ai-backend gpus split <prop1,prop2,...>", file=sys.stderr)
                sys.exit(1)
            persist_env_changes({"LLAMA_TENSOR_SPLIT": props})
            print(f"Tensor split pinned to {props}. (passed as --tensor-split to llama-server at serve)")
        else:
            cmd_gpus(args[1] if len(args) > 1 else None)
    elif cmd.startswith("hf://") or "/" in cmd or cmd.endswith(".gguf") or os.path.exists(cmd):
        cmd_use(cmd)
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        print_usage()
        sys.exit(1)

if __name__ == "__main__":
    main()

