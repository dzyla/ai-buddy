def cmd_tune(target=None):
    """Auto-tune context size, KV cache quantization, and speculative draft tokens for the active model.

    Benchmarks decoding speed across draft token counts, verifies memory fit to prevent
    system RAM spillover, and applies the highest-throughput configuration.
    """
    import statistics as st

    if target and target.strip():
        print(f"Switching to target model: {target}...")
        cmd_use(target)

    env_vars = load_env()
    model_path = env_vars.get("LLAMA_MODEL_PATH") or os.environ.get("LLAMA_MODEL_PATH")
    if not model_path or not os.path.exists(model_path):
        models = list_local_models()
        if not models:
            print(f"Error: No GGUF models found to tune.", file=sys.stderr)
            sys.exit(1)
        qwen_candidates = [m for m in models if "qwen3.8" in os.path.basename(m).lower() or "qwen" in os.path.basename(m).lower()]
        best_model = qwen_candidates[0] if qwen_candidates else max(models, key=lambda m: os.path.getsize(m) if os.path.exists(m) else 0)
        apply_model_path(best_model)
        model_path = str(best_model)

    model_name = os.path.basename(model_path)
    print(f"\n=======================================================")
    print(f"  ai-backend Auto-Tuner & Benchmark: {model_name}")
    print(f"=======================================================")

    # 1. Inspect GPU & VRAM capacity
    gpus = list_gpu_info()
    total_vram_mib = sum(g["total_mib"] for g in gpus) if gpus else 0
    gpu_names = ", ".join(g["name"] for g in gpus) if gpus else "CPU / Unknown"
    print(f"Detected GPU(s): {gpu_names} ({total_vram_mib} MiB VRAM total)")

    # 2. Determine safe context & KV cache quantization
    arch = read_gguf_arch(model_path) or {}
    try:
        model_mb = split_total_size(model_path) * 1024
    except Exception:
        model_mb = 9000
    has_mtp = (
        arch.get("nextn", 0) > 0
        or "mtp" in model_name.lower()
        or find_mtp_draft(model_path) is not None
        or "qwen3.8" in model_name.lower()
    )

    print(f"Model size: {model_mb/1024:.1f} GB | Architecture: {arch.get('arch', 'unknown')} | MTP Support: {'Yes' if has_mtp else 'No'}")

    # Recommended KV cache quant: q4_0 for large models (saves VRAM), q8_0 for small ones
    if model_mb > 10000:
        recommended_cache = "q4_0"
    elif model_mb > 4000:
        recommended_cache = "q8_0"
    else:
        recommended_cache = "q8_0"

    # Compute recommended ctx from available VRAM (baseline: no MTP, q4_0 if recommended)
    # This is what will be pinned after benchmarking — use best-case (no MTP) for ctx ceiling.
    recommended_ctx = calculate_auto_ctx(
        model_path,
        vram_free=total_vram_mib or None,
        use_mtp=False,
    )
    # Snap to a clean multiple of 4096 and cap at 262144
    recommended_ctx = min(262144, (recommended_ctx // 4096) * 4096)
    recommended_ctx = max(4096, recommended_ctx)

    print(f"\n[Step 1/3] Memory Optimization:")
    print(f"  → Setting KV Cache Quantization: {recommended_cache} (prevents VRAM spill)")
    cmd_cache_quant(recommended_cache)

    # Clear explicit ctx during benchmarking so start_server can inject a safe
    # per-candidate value. We apply the recommended ctx at the end.
    print(f"  → Clearing explicit ctx (will lock to {recommended_ctx} tokens after benchmark)")
    cmd_ctx("auto")


    # Helper: Wait for server ready, also watching for early server death
    def wait_ready(proc, timeout=180):
        t0 = time.time()
        stderr_lines = []
        while time.time() - t0 < timeout:
            # Check if server died
            rc = proc.poll()
            if rc is not None:
                # Drain stderr for diagnostics
                try:
                    out = proc.stderr.read().decode(errors="replace")
                    stderr_lines = out.splitlines()
                except Exception:
                    pass
                print(f"\n  [Server exited with code {rc}]")
                for ln in stderr_lines[-8:]:
                    print(f"    {ln}")
                return False
            try:
                with urllib.request.urlopen(f"http://127.0.0.1:{PORT}/health", timeout=1) as resp:
                    if resp.status == 200:
                        return True
            except Exception:
                pass
            time.sleep(1)
        return False

    # Helper: Stream generation
    def generate_eval(prompt, max_tokens=220, thinking=False):
        endpoint = f"http://127.0.0.1:{PORT}/v1/chat/completions"
        body = {
            "messages": [{"role": "user", "content": prompt}],
            "max_tokens": max_tokens,
            "stream": True,
            "temperature": 0.7 if not thinking else 1.0,
            "top_p": 0.8 if not thinking else 0.95,
            "top_k": 20,
        }
        if not thinking:
            body["chat_template_kwargs"] = {"enable_thinking": False}

        req = urllib.request.Request(endpoint, json.dumps(body).encode(), {"Content-Type": "application/json"})
        t0 = time.time()
        ttft = None
        n = 0
        try:
            with urllib.request.urlopen(req, timeout=90) as r:
                for line in r:
                    line = line.decode().strip()
                    if not line.startswith("data: ") or line == "data: [DONE]":
                        continue
                    delta = json.loads(line[6:])["choices"][0].get("delta", {})
                    if delta.get("content") or delta.get("reasoning_content"):
                        now = time.time()
                        if ttft is None:
                            ttft = now - t0
                        n += 1
            span = time.time() - t0 - (ttft or 0)
            return (n / span if span > 0 else 0.0), ttft or 0.0, n
        except Exception:
            return 0.0, 0.0, 0

    # Helper: Server metrics query
    def get_metrics():
        req = urllib.request.Request(f"http://127.0.0.1:{PORT}/metrics")
        m = {}
        try:
            with urllib.request.urlopen(req, timeout=3) as resp:
                for line in resp.read().decode().splitlines():
                    if line.startswith("#") or not line.strip():
                        continue
                    parts = line.split()
                    if len(parts) >= 2:
                        try:
                            m[parts[0]] = float(parts[1])
                        except ValueError:
                            pass
        except Exception:
            pass
        return m

    # Helper: Start server subprocess for benchmarking
    def start_server(use_mtp_flag=False):
        """Launch ai-backend serve in a subprocess with a VRAM-safe context size.

        Computes a fresh auto-ctx for each MTP candidate so the VRAM preflight
        always passes regardless of what's pinned in the env file.
        stderr=PIPE — read only on server death, never blocks since we drain it
        only when proc.poll() is non-None.
        """
        serve_env = os.environ.copy()
        # Force-compute a safe ctx for this candidate (ignores any pinned value)
        gpus = list_gpu_info()
        agg_free = sum(g.get("free_mib", 0) for g in gpus)
        safe_ctx = calculate_auto_ctx(
            model_path,
            vram_free=agg_free or None,
            use_mtp=use_mtp_flag,
        )
        # Cap to recommended_ctx ceiling so we're benchmarking realistic sizes
        safe_ctx = min(safe_ctx, recommended_ctx)
        serve_env["LLAMA_CTX_SIZE"] = str(safe_ctx)
        print(f"    (using ctx={safe_ctx} for this run)", flush=True)
        proc = subprocess.Popen(
            [sys.argv[0], "serve"],
            env=serve_env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
        )
        return proc

    # Helper: Stop server subprocess
    def stop_server(proc):
        """Terminate the server process and wait for it to exit."""
        if proc is None:
            return
        try:
            proc.terminate()
            proc.wait(timeout=15)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
        except Exception:
            pass

    # 3. Benchmark MTP / Speculative Decoding Candidates
    eval_prompts = [
        ("code", "Write a python function `quickselect(arr, k)` that finds the k-th smallest element in O(n) average time with docstring."),
        ("explain", "Explain the technical trade-offs between Multi-Token Prediction and traditional speculative decoding in LLM inference in one concise paragraph."),
    ]

    candidates = [0]  # 0 = baseline (off)
    if has_mtp:
        candidates.extend([1, 2, 3, 4])

    print(f"\n[Step 2/3] Benchmarking Speculative Decoding Configurations...")
    benchmarks = []

    for draft_n in candidates:
        tag = "Baseline (No MTP)" if draft_n == 0 else f"MTP (draft-n={draft_n})"
        print(f"  Starting server for {tag}...", flush=True)

        # Apply MTP setting to env file, then start the server
        if draft_n == 0:
            cmd_mtp("off")
        else:
            cmd_mtp(str(draft_n))

        srv_proc = start_server(use_mtp_flag=(draft_n > 0))

        print(f"  Waiting for server (up to 3 min)...", end="", flush=True)
        if not wait_ready(srv_proc, timeout=180):
            print(" [Server Start Failed — skipping]")
            stop_server(srv_proc)
            continue
        print(" Ready.", flush=True)

        # Warmup — prime KV cache and GPU before timing
        print(f"  Warming up...", end="", flush=True)
        generate_eval("warmup", max_tokens=20, thinking=False)
        print(" Done.", flush=True)
        m0 = get_metrics()

        fast_rates = []
        think_rates = []
        ttfts = []

        for cat, prompt in eval_prompts:
            print(f"  Benchmarking [{cat}]...", end="", flush=True)
            rate_f, ttft_f, _ = generate_eval(prompt, max_tokens=180, thinking=False)
            rate_t, ttft_t, _ = generate_eval(prompt, max_tokens=200, thinking=True)
            if rate_f > 0:
                fast_rates.append(rate_f)
                ttfts.append(ttft_f)
            if rate_t > 0:
                think_rates.append(rate_t)
            print(f" {rate_f:.1f} tok/s", flush=True)

        m1 = get_metrics()
        draft_tot = m1.get("llamacpp:spec_decode_num_draft_tokens_total", 0) - m0.get("llamacpp:spec_decode_num_draft_tokens_total", 0)
        acc_tot = m1.get("llamacpp:spec_decode_num_accepted_tokens_total", 0) - m0.get("llamacpp:spec_decode_num_accepted_tokens_total", 0)
        acc_rate = (acc_tot / draft_tot * 100) if draft_tot > 0 else 0.0

        med_fast = st.median(fast_rates) if fast_rates else 0.0
        med_think = st.median(think_rates) if think_rates else 0.0
        med_ttft = st.median(ttfts) if ttfts else 0.0

        print(f"  → {tag}: Non-Thinking: {med_fast:5.1f} tok/s | Thinking: {med_think:5.1f} tok/s | Acc: {acc_rate:4.1f}%")

        benchmarks.append({
            "draft_n": draft_n,
            "label": tag,
            "fast_tok_s": med_fast,
            "think_tok_s": med_think,
            "ttft": med_ttft,
            "acc_rate": acc_rate,
            "combined_score": med_fast * 0.6 + med_think * 0.4,
        })

        # Stop the server before starting with the next candidate
        print(f"  Stopping server...", flush=True)
        stop_server(srv_proc)
        time.sleep(3)  # brief pause to let GPU memory and port release

    # 4. Select Optimal Configuration
    print(f"\n[Step 3/3] Selecting Best Configuration:")
    if not benchmarks:
        print("Error: No benchmark runs succeeded. Is llama-server installed and working?", file=sys.stderr)
        return

    best = max(benchmarks, key=lambda b: b["combined_score"])
    baseline = next((b for b in benchmarks if b["draft_n"] == 0), benchmarks[0])

    speedup = ((best["fast_tok_s"] - baseline["fast_tok_s"]) / baseline["fast_tok_s"] * 100) if baseline["fast_tok_s"] > 0 else 0.0

    print(f"  ★ Optimal Setting: {best['label']}")
    print(f"  ★ Speedup over Baseline: +{speedup:.1f}%")

    if best["draft_n"] == 0:
        cmd_mtp("off")
        final_use_mtp = False
    else:
        cmd_mtp(str(best["draft_n"]))
        final_use_mtp = True

    # Re-calculate safe resident context size with the winning MTP choice to fit VRAM accurately
    final_safe_ctx = calculate_auto_ctx(
        model_path,
        vram_free=total_vram_mib or None,
        use_mtp=final_use_mtp,
    )
    final_safe_ctx = min(262144, (final_safe_ctx // 4096) * 4096)
    final_safe_ctx = max(4096, final_safe_ctx)

    print(f"  → Locking context size to {final_safe_ctx} tokens")
    cmd_ctx(str(final_safe_ctx))
    recommended_ctx = final_safe_ctx

    # Final summary table
    print(f"\n" + "=" * 68)
    print(f"  BENCHMARK & TUNING SUMMARY")
    print(f"=" * 68)
    print(f"  Model:                 {model_name}")
    print(f"  Resident Context Size: {recommended_ctx} tokens")
    print(f"  KV Cache Quantization: {recommended_cache}")
    print(f"  Optimal MTP Tokens:    {best['draft_n']} ({best['label']})")
    print(f"  Decode Throughput:     {best['fast_tok_s']:.1f} tok/s non-thinking | {best['think_tok_s']:.1f} tok/s thinking")
    print(f"  Draft Acceptance Rate: {best['acc_rate']:.1f}%")
    print(f"=" * 68)
    print(f"\n  Settings applied. Run `ai-backend serve` to start the server.")


