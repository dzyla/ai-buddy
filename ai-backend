    if not target:
        cmd_list()
        print("")
        sel = input("Enter path, number from list, or HF repo/URI: ").strip()
        if not sel:
            print("No selection made.")
            return
        target = sel

    if target in ("qwen3-6", "qwen3", "gemma4"):
        if target in ("qwen3-6", "qwen3"):
            ep = get_snap_endpoint("qwen3-6")
            if ep:
                write_env(ep, "qwen3-6")
                print(f"Switched to qwen3-6 ({ep})")
                return
        elif target == "gemma4":
            ep = get_snap_endpoint("gemma4")
            if ep:
                write_env(ep, "gemma4")
                print(f"Switched to gemma4 ({ep})")
                return

    # Check known model aliases / shortcuts
    target_lower = target.lower().strip()
    presets = {
        "qwen3.8": "unsloth/Qwen3.8-27B-GGUF",
        "qwen3.8-27b": "unsloth/Qwen3.8-27B-GGUF",
        "qwen3.8-2.4t": "unsloth/Qwen3.8-2.4T-A95B-GGUF",
        "qwen3.8-a95b": "unsloth/Qwen3.8-2.4T-A95B-GGUF",
        "qwen3_8": "unsloth/Qwen3.8-27B-GGUF",
        "qwen38": "unsloth/Qwen3.8-27B-GGUF",
        "qwen3.6": "Qwen/Qwen3.6-35B-A3B",
        "gemma4-12b": "unsloth/gemma-4-12b-it-GGUF",
    }
    if target_lower in presets:
        # Check if matching model already exists locally
        for m in list_local_models():
            m_name = m.name.lower()
            if target_lower in m_name or target_lower.replace(".", "_") in m_name or target_lower.replace(".", "") in m_name:
                print(f"Found local matching model: {m}")
                apply_model_path(m)
                return
        target = presets[target_lower]

    local_path = Path(target).expanduser().resolve() if os.path.exists(target) else MODEL_DIR / target
    if local_path.exists() and local_path.is_file():
        apply_model_path(local_path)
        return

    if target.isdigit():
        models = list_local_models()
        idx = int(target) - 1
        if 0 <= idx < len(models):
            apply_model_path(models[idx])
            return

    if target.startswith("hf://") or "/" in target or target.endswith(".gguf"):
        print(f"Resolving HuggingFace model target: {target}...")
        model_file = download_hf_target(target)
        apply_model_path(model_file)
        return

    print(f"Error: Could not resolve target: {target}", file=sys.stderr)
    sys.exit(1)

