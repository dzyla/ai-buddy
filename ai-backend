def kill_llama_server():
    if is_systemd_service_active():
        print("Stopping llama-server.service...")
        subprocess.run(["systemctl", "--user", "stop", "llama-server.service"], capture_output=True)
    try:
        res = subprocess.run(["pgrep", "-f", "llama-server.*--model"], capture_output=True, text=True)
        pids = res.stdout.strip().split()
        for pid in pids:
            print(f"Stopping running llama-server (PID {pid})...")
            subprocess.run(["kill", pid], capture_output=True)
    except Exception:
        pass

