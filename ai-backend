def cmd_ctx(size=None):
    if not size:
        print("Usage: ai-backend ctx <size|auto>")
        return
    s = size.strip().lower()
    if s == "auto":
        persist_env_changes({"LLAMA_CTX_SIZE": None, "INFER_CONTEXT_WINDOW": None})
        print("Context size reset to auto (calculated from available VRAM/RAM).")
    else:
        parsed = None
        if s.endswith("k"):
            try:
                parsed = str(int(float(s[:-1]) * 1024))
            except ValueError:
                pass
        elif s.endswith("m"):
            try:
                parsed = str(int(float(s[:-1]) * 1024 * 1024))
            except ValueError:
                pass
        elif s.isdigit():
            parsed = s

        if not parsed:
            print(f"Invalid size '{size}'. Use a number (e.g. 524288, 512k, 256k) or 'auto'.", file=sys.stderr)
            sys.exit(1)
        persist_env_changes({"LLAMA_CTX_SIZE": parsed, "INFER_CONTEXT_WINDOW": parsed})
        sync_ctx_to_systemd(parsed)
        print(f"Context size locked to {parsed} tokens.")

def cmd_cache_quant(quant_type=None):
    """Configure KV cache quantization (q4_0, q8_0, f16, etc.) to prevent VRAM overflow."""
    if not quant_type:
        env_vars = load_env()
        k = env_vars.get("LLAMA_CACHE_TYPE_K", "q8_0")
        v = env_vars.get("LLAMA_CACHE_TYPE_V", "q8_0")
        print(f"Current KV Cache Quantization: K={k}, V={v}")
        print("Usage: ai-backend cache <q4_0|q8_0|f16|auto>")
        return

    q = quant_type.strip().lower()
    mapping = {
        "4bit": "q4_0",
        "4-bit": "q4_0",
        "q4": "q4_0",
        "q4_0": "q4_0",
        "q4_1": "q4_1",
        "8bit": "q8_0",
        "8-bit": "q8_0",
        "q8": "q8_0",
        "q8_0": "q8_0",
        "q5": "q5_0",
        "q5_0": "q5_0",
        "q5_1": "q5_1",
        "fp16": "f16",
        "f16": "f16",
        "full": "f16",
        "auto": "q4_0",
    }
    if q not in mapping:
        print(f"Invalid cache quantization '{quant_type}'. Supported: q4_0 (4-bit), q8_0 (8-bit), f16 (full FP16), auto.", file=sys.stderr)
        sys.exit(1)

    target_type = mapping[q]
    persist_env_changes({
        "LLAMA_CACHE_TYPE_K": target_type,
        "LLAMA_CACHE_TYPE_V": target_type
    })
    print(f"KV Cache quantization set to {target_type} (K={target_type}, V={target_type}).")
    if target_type == "q4_0":
        print("  → KV cache memory usage reduced by ~4x (recommended for 16GB GPUs like RTX 5080/4080).")
    elif target_type == "q8_0":
        print("  → KV cache memory usage reduced by ~2x.")
    elif target_type == "f16":
        print("  → Full FP16 precision KV cache.")

