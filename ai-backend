def cmd_yarn(sel=None):
    """Enable/configure YaRN RoPE scaling to expand the context window beyond the
    model's native training length (Qwen3.8-27B: native 262144; scale 4 -> ~1M).

    Persists LLAMA_ROPE_SCALING / LLAMA_ROPE_SCALE / LLAMA_YARN_ORIG_CTX to the env
    file; `ai-backend serve` translates them into --rope-scaling/--rope-scale/
    --yarn-orig-ctx on the llama-server command line. The other YaRN knobs
    (ext-factor, attn-factor, beta-slow/fast) are auto-derived by llama.cpp from
    scale + orig-ctx, so they are not set explicitly.

    Usage:
      ai-backend yarn            # show current YaRN state
      ai-backend yarn on         # YaRN scale 4 (native 262144 -> ~1M)
      ai-backend yarn off        # disable (native context only)
      ai-backend yarn 2          # scale 2 (-> ~512K); scale 8 -> ~2M
    """
    env_vars = load_env()
    scaling = (env_vars.get("LLAMA_ROPE_SCALING") or "").strip()
    scale = (env_vars.get("LLAMA_ROPE_SCALE") or "").strip()
    orig = (env_vars.get("LLAMA_YARN_ORIG_CTX") or "").strip()

    def _state():
        if scaling and scaling.lower() != "yarn":
            return f"rope-scaling={scaling}"
        if not scaling or not scale:
            return "off (native context only)"
        mult = float(scale)
        native = int(orig) if orig.isdigit() else 262144
        return f"yarn scale={scale} (orig-ctx {orig or '262144'} -> ~{int(native*mult):,} tokens)"

    if sel is None:
        print(f"YaRN: {_state()}")
        print(f"  LLAMA_ROPE_SCALING={scaling or '(unset)'}  LLAMA_ROPE_SCALE={scale or '(unset)'}  LLAMA_YARN_ORIG_CTX={orig or '(unset)'}")
        print("\nUsage: ai-backend yarn <on|off|<scale>>   (on = scale 4 -> ~1M for Qwen3.8-27B)")
        return

    sel = sel.strip().lower()
    if sel in ("off", "0", "disable", "clear", "unset", "none"):
        persist_env_changes({"LLAMA_ROPE_SCALING": None, "LLAMA_ROPE_SCALE": None, "LLAMA_YARN_ORIG_CTX": None})
        print("YaRN disabled — server will use the model's native context only.")
        return
    if sel in ("on", "1", "enable", "default"):
        scale, orig = "4.0", "262144"
    else:
        try:
            scale = f"{float(sel):g}"
        except ValueError:
            print(f"Unknown YaRN option '{sel}'. Use on|off|<scale number>.", file=sys.stderr)
            sys.exit(1)
        orig = "262144"
    persist_env_changes({"LLAMA_ROPE_SCALING": "yarn", "LLAMA_ROPE_SCALE": scale, "LLAMA_YARN_ORIG_CTX": orig})
    native = int(orig)
    print(f"YaRN enabled: scale={scale} (orig-ctx {orig} -> ~{int(native*float(scale)):,} tokens).")
    print("Takes effect on the next (re)serve; pair with `ai-backend ctx <size>` if you also raise the context.")


