def cmd_gpus(sel=None):
    """Select which GPUs llama-server uses (single vs all). Persists to env + systemd."""
    gpus = list_gpu_info()
    env_vars = load_env()
    current = env_vars.get("CUDA_VISIBLE_DEVICES")
    ts = env_vars.get("LLAMA_TENSOR_SPLIT")

    if sel is None:
        print("=== GPUs ===")
        if not gpus:
            print("  (nvidia-smi not found)")
        else:
            for g in gpus:
                mark = " ⇐ selected" if current and str(g["index"]) in current.split(",") else ""
                free_gb = g["free_mib"] / 1024
                tot_gb = g["total_mib"] / 1024
                print(f"  GPU{g['index']}  {g['name']:<36} {tot_gb:6.1f} GB total, {free_gb:6.1f} GB free{mark}")
        print(f"\nActive CUDA_VISIBLE_DEVICES: {current or '(unset, will auto-select)'}")
        print(f"Tensor split: {ts or '(auto/computed at serve)'}")
        print("\nUsage:")
        print("  ai-backend gpus all               Use every detected GPU (multi-GPU split)")
        print("  ai-backend gpus 0,2,3             Use specific GPUs")
        print("  ai-backend gpus 1                 Use a single GPU")
        print("  ai-backend gpus auto              Auto: single largest if it holds the model, else all")
        print("  ai-backend gpus split 1,1,2,1     Pin an explicit --tensor-split")
        return

    if sel == "auto":
        cuda_dev = default_gpu_selection()
        persist_env_changes({"CUDA_VISIBLE_DEVICES": cuda_dev, "LLAMA_TENSOR_SPLIT": None})
        sync_gpu_to_systemd(cuda_dev)
        print(f"Auto-selected CUDA_VISIBLE_DEVICES={cuda_dev}")
        return

    if sel == "split":
        # `split` expects a second arg (the proportions); handled below via main().
        return

    if sel == "all":
        idxs = [g["index"] for g in gpus] if gpus else []
        if not idxs:
            print("No GPUs detected via nvidia-smi.", file=sys.stderr)
            sys.exit(1)
        cuda_dev = ",".join(str(i) for i in sorted(idxs))
        persist_env_changes({"CUDA_VISIBLE_DEVICES": cuda_dev, "LLAMA_TENSOR_SPLIT": None})
        sync_gpu_to_systemd(cuda_dev)
        print(f"Using all GPUs: CUDA_VISIBLE_DEVICES={cuda_dev}")
        print("Tensor split will be computed automatically from per-GPU VRAM at serve time.")
        return

    idxs = parse_gpu_sel(sel)
    if not idxs:
        print(f"Invalid GPU selection: {sel}", file=sys.stderr)
        sys.exit(1)
    cuda_dev = ",".join(str(i) for i in sorted(idxs))
    persist_env_changes({"CUDA_VISIBLE_DEVICES": cuda_dev, "LLAMA_TENSOR_SPLIT": None})
    sync_gpu_to_systemd(cuda_dev)
    if len(idxs) == 1:
        print(f"Using single GPU: CUDA_VISIBLE_DEVICES={cuda_dev}")
    else:
        print(f"Using GPUs: CUDA_VISIBLE_DEVICES={cuda_dev}")
        print("Tensor split will be computed automatically from per-GPU VRAM at serve time.")

def patch_env_key(key, value):
    env_vars = load_env()
    if value is None:
        env_vars.pop(key, None)
    else:
        env_vars[key] = value
    url = env_vars.get("INFER_BASE_URL", f"http://localhost:{PORT}/v1/")
    model = env_vars.get("INFER_MODEL", "llama")
    llama_path = env_vars.get("LLAMA_MODEL_PATH")
    write_env(url, model, llama_path, env_vars)


def sync_ctx_to_systemd(ctx_size):
    """Keep the systemd service's LLAMA_CTX_SIZE in sync with the env file."""
    if not SYSTEMD_SERVICE.exists():
        return
    try:
        content = SYSTEMD_SERVICE.read_text()
        new_content = re.sub(
            r'^Environment=LLAMA_CTX_SIZE=.*',
            f'Environment=LLAMA_CTX_SIZE={ctx_size}',
            content,
            flags=re.MULTILINE,
        )
        if new_content != content:
            SYSTEMD_SERVICE.write_text(new_content)
            subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
            print(f"[llama-wrapper] Synced systemd LLAMA_CTX_SIZE={ctx_size}")
        else:
            print(f"[llama-wrapper] systemd LLAMA_CTX_SIZE already {ctx_size}")
    except Exception as e:
        print(f"Warning syncing systemd service: {e}", file=sys.stderr)

def print_usage():
    print("""ai-backend — single tool for LLM model deployment and configuration

Usage:
  ai-backend                            Show active backend & downloaded models
  ai-backend status                     Show status of backends and models
  ai-backend download <hf_uri|repo>     Download model from Hugging Face
                                         (supports hf://... URIs and split GGUFs)
  ai-backend use <model|path|hf_uri>    Switch active model (downloads if needed)
  ai-backend list                       List all downloaded GGUF models
  ai-backend auto                       Switch to best running backend
  ai-backend ctx <size|auto>            Set or clear explicit context size
  ai-backend draft <path|auto|off>      Set/clear the dspark draft model for speedup
  ai-backend gpu-layers <n|auto>        Set or clear GPU offload layer count
  ai-backend gpus [all|<devs>|auto|split <p>]   Select GPUs (single vs multi-GPU split)
  ai-backend serve                      Run llama-server with auto context sizing

Examples:
  ai-backend use hf://AtomicChat/Ling-3.0-flash-GGUF/AD-IQ3_M/Ling-3.0-flash-AD-IQ3_M-00001-of-00002.gguf
  ai-backend use my-model.gguf
  ai-backend ctx 16384
  ai-backend gpus all                   # spread a >1-GPU model across every card
  ai-backend gpus split 1,1,1,4         # explicit tensor-split proportions
""")

def main():
    prog = os.path.basename(sys.argv[0])
    
    if prog in ("llama-server-wrapper.sh", "llama-wrapper"):
        cmd_serve()
        return

    args = sys.argv[1:]
    if not args:
        cmd_status()
        return

    cmd = args[0]

    if cmd in ("-h", "--help", "help"):
        print_usage()
        return
    elif cmd in ("status", "info"):
        cmd_status()
    elif cmd in ("list", "ls", "models"):
        cmd_list()
    elif cmd in ("serve", "run", "wrapper"):
        cmd_serve()
    elif cmd in ("download", "get", "gguf"):
        target = args[1] if len(args) > 1 else None
        if not target:
            print("Usage: ai-backend download <hf_url_or_repo_or_uri>")
            sys.exit(1)
        dest = download_hf_target(target)
        print(f"Model downloaded: {dest}")
        apply_model_path(dest)
    elif cmd in ("use", "set", "switch", "local", "llama", "qwen3", "qwen3-6", "qwen3-30", "gemma4"):
        target = args[1] if len(args) > 1 else (cmd if cmd in ("qwen3", "qwen3-6", "qwen3-30", "gemma4") else None)
        cmd_use(target)
    elif cmd == "auto":
        cmd_auto()
    elif cmd == "ctx":
        cmd_ctx(args[1] if len(args) > 1 else None)
    elif cmd in ("draft", "dspark"):
        cmd_draft(args[1] if len(args) > 1 else None)
    elif cmd in ("gpu-layers", "gpulayers"):
        cmd_gpu_layers(args[1] if len(args) > 1 else None)
    elif cmd in ("gpus", "gpu", "tensor-split"):
        # `gpus split <props>` pins an explicit tensor split; everything else selects devices.
        if len(args) > 1 and args[1] == "split":
            props = args[2] if len(args) > 2 else None
            if not props:
                print("Usage: ai-backend gpus split <prop1,prop2,...>", file=sys.stderr)
                sys.exit(1)
            persist_env_changes({"LLAMA_TENSOR_SPLIT": props})
            print(f"Tensor split pinned to {props}. (passed as --tensor-split to llama-server at serve)")
        else:
            cmd_gpus(args[1] if len(args) > 1 else None)
    elif cmd.startswith("hf://") or "/" in cmd or cmd.endswith(".gguf") or os.path.exists(cmd):
        cmd_use(cmd)
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        print_usage()
        sys.exit(1)

if __name__ == "__main__":
    main()
