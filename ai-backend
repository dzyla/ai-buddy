    print("\n=== Available Backends ===")
    for snap in ("qwen3-6", "gemma4"):
        if shutil.which(snap):
            ep = get_snap_endpoint(snap) or "?"
            status = "[RUNNING]" if is_snap_active(snap) else "[stopped]"
            print(f"  {snap:<10} {status:<10} {ep}")
            
    llama_running = False
    try:
        with urllib.request.urlopen(f"http://localhost:{PORT}/health", timeout=2) as resp:
            if resp.status == 200:
                llama_running = True
    except Exception:
        pass
        
    llama_status = "[RUNNING]" if llama_running else "[stopped]"
    print(f"  llama      {llama_status:<10} http://localhost:{PORT}/v1/")
    
    print("\n=== Downloaded Models ===")
    models = list_local_models()
    active_model = env_vars.get("LLAMA_MODEL_PATH")
    if not models:
        print("  (none found in ~/.local/share/ai/models/)")
    else:
        for m in models:
            size_gb = os.path.getsize(m) / (1024**3)
            size_str = f"{size_gb:.1f} GB"
            is_active = str(m) == active_model
            marker = " ← active" if is_active else ""
            prefix = "*" if is_active else " "
            print(f"  {prefix} {m.name}  [{size_str}]{marker}")

def cmd_list():
    env_vars = load_env()
    active = env_vars.get("LLAMA_MODEL_PATH")
    models = list_local_models()
    print(f"Downloaded models in {MODEL_DIR}:")
    if not models:
        print("  (none)")
        return
    for i, m in enumerate(models, 1):
        size_gb = os.path.getsize(m) / (1024**3)
        size_str = f"{size_gb:.1f} GB"
        is_active = str(m) == active
        marker = " ← active" if is_active else ""
        prefix = "*" if is_active else " "
        print(f"  {prefix} {i}) {m.name} [{size_str}]{marker}")

def cmd_use(target=None):
    if not target:
        cmd_list()
        print("")
        sel = input("Enter path, number from list, or HF repo/URI: ").strip()
        if not sel:
            print("No selection made.")
            return
        target = sel

    if target in ("qwen3-6", "qwen3", "gemma4"):
        if target in ("qwen3-6", "qwen3"):
            ep = get_snap_endpoint("qwen3-6")
            if ep:
                write_env(ep, "qwen3-6")
                print(f"Switched to qwen3-6 ({ep})")
                return
        elif target == "gemma4":
            ep = get_snap_endpoint("gemma4")
            if ep:
                write_env(ep, "gemma4")
                print(f"Switched to gemma4 ({ep})")
                return

    local_path = Path(target).expanduser().resolve() if os.path.exists(target) else MODEL_DIR / target
    if local_path.exists() and local_path.is_file():
        apply_model_path(local_path)
        return

    if target.isdigit():
        models = list_local_models()
        idx = int(target) - 1
        if 0 <= idx < len(models):
            apply_model_path(models[idx])
            return

    if target.startswith("hf://") or "/" in target or target.endswith(".gguf"):
        print(f"Resolving HuggingFace model target: {target}...")
        model_file = download_hf_target(target)
        apply_model_path(model_file)
        return

    print(f"Error: Could not resolve target: {target}", file=sys.stderr)
    sys.exit(1)

def cmd_auto():
    if is_snap_active("qwen3-6"):
        ep = get_snap_endpoint("qwen3-6")
        write_env(ep, "qwen3-6")
        print(f"Switched to qwen3-6 ({ep})")
    elif is_snap_active("gemma4"):
        ep = get_snap_endpoint("gemma4")
        write_env(ep, "gemma4")
        print(f"Switched to gemma4 ({ep})")
    else:
        models = list_local_models()
        if models:
            apply_model_path(models[0])
        else:
            print("No active backend or model found.")
            sys.exit(1)

def cmd_ctx(size=None):
    if not size:
        print("Usage: ai-backend ctx <size|auto>")
        return
    if size == "auto":
        patch_env_key("LLAMA_CTX_SIZE", None)
        print("Context size reset to auto (calculated from available VRAM/RAM).")
    else:
        if not size.isdigit():
            print(f"Invalid size '{size}'. Use a number or 'auto'.", file=sys.stderr)
            sys.exit(1)
        patch_env_key("LLAMA_CTX_SIZE", size)
        sync_ctx_to_systemd(size)
        print(f"Context size locked to {size} tokens.")

def cmd_gpu_layers(n=None):
    if not n:
        print("Usage: ai-backend gpu-layers <n|auto>")
        return
    if n == "auto":
        patch_env_key("LLAMA_N_GPU_LAYERS", None)
        print("GPU layers reset to auto (default 99).")
    else:
        if not n.isdigit():
            print(f"Invalid value '{n}'. Use a number or 'auto'.", file=sys.stderr)
            sys.exit(1)
        patch_env_key("LLAMA_N_GPU_LAYERS", n)
        print(f"GPU layers set to {n}.")

def patch_env_key(key, value):
    env_vars = load_env()
    if value is None:
        env_vars.pop(key, None)
    else:
        env_vars[key] = value
    url = env_vars.get("INFER_BASE_URL", f"http://localhost:{PORT}/v1/")
    model = env_vars.get("INFER_MODEL", "llama")
    llama_path = env_vars.get("LLAMA_MODEL_PATH")
    write_env(url, model, llama_path, env_vars)


def sync_ctx_to_systemd(ctx_size):
    """Keep the systemd service's LLAMA_CTX_SIZE in sync with the env file."""
    if not SYSTEMD_SERVICE.exists():
        return
    try:
        content = SYSTEMD_SERVICE.read_text()
        new_content = re.sub(
            r'^Environment=LLAMA_CTX_SIZE=.*',
            f'Environment=LLAMA_CTX_SIZE={ctx_size}',
            content,
            flags=re.MULTILINE,
        )
        if new_content != content:
            SYSTEMD_SERVICE.write_text(new_content)
            subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
            print(f"[llama-wrapper] Synced systemd LLAMA_CTX_SIZE={ctx_size}")
        else:
            print(f"[llama-wrapper] systemd LLAMA_CTX_SIZE already {ctx_size}")
    except Exception as e:
        print(f"Warning syncing systemd service: {e}", file=sys.stderr)

def print_usage():
    print("""ai-backend — single tool for LLM model deployment and configuration

Usage:
  ai-backend                            Show active backend & downloaded models
  ai-backend status                     Show status of backends and models
  ai-backend download <hf_uri|repo>     Download model from Hugging Face
                                         (supports hf://... URIs and split GGUFs)
  ai-backend use <model|path|hf_uri>    Switch active model (downloads if needed)
  ai-backend list                       List all downloaded GGUF models
  ai-backend auto                       Switch to best running backend
  ai-backend ctx <size|auto>            Set or clear explicit context size
  ai-backend gpu-layers <n|auto>        Set or clear GPU offload layer count
  ai-backend serve                      Run llama-server with auto context sizing

Examples:
  ai-backend use hf://AtomicChat/Ling-3.0-flash-GGUF/AD-IQ3_M/Ling-3.0-flash-AD-IQ3_M-00001-of-00002.gguf
  ai-backend use my-model.gguf
  ai-backend ctx 16384
""")

def main():
    prog = os.path.basename(sys.argv[0])
    
    if prog in ("llama-server-wrapper.sh", "llama-wrapper"):
        cmd_serve()
        return

    args = sys.argv[1:]
    if not args:
        cmd_status()
        return

    cmd = args[0]

    if cmd in ("-h", "--help", "help"):
        print_usage()
        return
    elif cmd in ("status", "info"):
        cmd_status()
    elif cmd in ("list", "ls", "models"):
        cmd_list()
    elif cmd in ("serve", "run", "wrapper"):
        cmd_serve()
    elif cmd in ("download", "get", "gguf"):
        target = args[1] if len(args) > 1 else None
        if not target:
            print("Usage: ai-backend download <hf_url_or_repo_or_uri>")
            sys.exit(1)
        dest = download_hf_target(target)
        print(f"Model downloaded: {dest}")
        apply_model_path(dest)
    elif cmd in ("use", "set", "switch", "local", "llama", "qwen3", "qwen3-6", "qwen3-30", "gemma4"):
        target = args[1] if len(args) > 1 else (cmd if cmd in ("qwen3", "qwen3-6", "qwen3-30", "gemma4") else None)
        cmd_use(target)
    elif cmd == "auto":
        cmd_auto()
    elif cmd == "ctx":
        cmd_ctx(args[1] if len(args) > 1 else None)
    elif cmd in ("gpu-layers", "gpulayers"):
        cmd_gpu_layers(args[1] if len(args) > 1 else None)
    elif cmd.startswith("hf://") or "/" in cmd or cmd.endswith(".gguf") or os.path.exists(cmd):
        cmd_use(cmd)
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        print_usage()
        sys.exit(1)

if __name__ == "__main__":
    main()
