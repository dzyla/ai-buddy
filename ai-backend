def parse_hf_target(target):
    t = target.strip()
    if t.startswith("hf://"):
        t = t[5:]
    elif t.startswith("https://huggingface.co/"):
        t = t[23:]
    elif t.startswith("http://huggingface.co/"):
        t = t[22:]
    
    t = t.lstrip("/")
    t = re.sub(r'^(blob|resolve)/[^/]+/', '', t)
    
    parts = t.split('/')
    if len(parts) >= 2:
        repo = f"{parts[0]}/{parts[1]}"
        rel_path = "/".join(parts[2:]) if len(parts) > 2 else ""
        return repo, rel_path
    return t, ""

def fetch_hf_repo_files(repo):
    headers = {"User-Agent": "ai-backend/1.0"}
    token = os.environ.get("HF_TOKEN")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    
    candidate_repos = [repo]
    if not repo.lower().endswith("-gguf"):
        candidate_repos.extend([f"{repo}-GGUF", f"{repo}-gguf"])

    for cand in candidate_repos:
        api_url = f"https://huggingface.co/api/models/{cand}/tree/main"
        req = urllib.request.Request(api_url, headers=headers)
        files = []
        try:
            with urllib.request.urlopen(req, timeout=15) as resp:
                data = json.loads(resp.read().decode('utf-8'))
                for item in data:
                    if isinstance(item, dict):
                        path = item.get("path", "")
                        if path.endswith(".gguf") and not os.path.basename(path).startswith("mmproj"):
                            files.append(path)
        except Exception:
            api_url = f"https://huggingface.co/api/models/{cand}"
            req = urllib.request.Request(api_url, headers=headers)
            try:
                with urllib.request.urlopen(req, timeout=15) as resp:
                    data = json.loads(resp.read().decode('utf-8'))
                    for s in data.get("siblings", []):
                        rfn = s.get("rfilename", "")
                        if rfn.endswith(".gguf") and not os.path.basename(rfn).startswith("mmproj"):
                            files.append(rfn)
            except Exception:
                pass
        if files:
            return cand, files
    return repo, []

def download_file(repo, rel_path):
    MODEL_DIR.mkdir(parents=True, exist_ok=True)
    filename = os.path.basename(rel_path)
    dest = MODEL_DIR / filename
    
    if dest.is_symlink() and not dest.exists():
        print(f"Removing broken symlink: {dest}", file=sys.stderr)
        dest.unlink()
        
    if dest.exists():
        print(f"Model already present: {dest}", file=sys.stderr)
        return dest

    url = f"https://huggingface.co/{repo}/resolve/main/{rel_path}"
    print(f"Downloading {filename} from {repo}...", file=sys.stderr)
    print(f"URL: {url}", file=sys.stderr)
    
    token = os.environ.get("HF_TOKEN")
    cmd = ["curl", "-L", "--progress-bar", "--fail"]
    if token:
        cmd.extend(["-H", f"Authorization: Bearer {token}"])
    tmp_dest = str(dest) + ".part"
    cmd.extend([url, "-o", tmp_dest])
    
    res = subprocess.run(cmd)
    if res.returncode != 0:
        if os.path.exists(tmp_dest):
            os.remove(tmp_dest)
        raise RuntimeError(f"Download failed for {url}")
        
    os.rename(tmp_dest, dest)
    print(f"Downloaded: {dest}", file=sys.stderr)
    return dest

def download_hf_target(target):
    repo, rel_path = parse_hf_target(target)
    if not repo:
        raise ValueError(f"Invalid HuggingFace target: {target}")
        
    resolved_repo, files = fetch_hf_repo_files(repo)
    if files:
        repo = resolved_repo

    if not rel_path:
        if not files:
            raise ValueError(f"No .gguf files found in {repo}")
        print(f"Available GGUF files in {repo}:")
        for i, f in enumerate(files, 1):
            print(f"  {i}) {f}")
        choice = input("Enter choice number or filename: ").strip()
        if choice.isdigit():
            idx = int(choice) - 1
            if 0 <= idx < len(files):
                rel_path = files[idx]
            else:
                raise ValueError("Invalid selection")
        else:
            rel_path = choice
            
    split_match = re.search(r'^(.*?)-(\d{5})-of-(\d{5})\.gguf$', rel_path)
    if split_match:
        prefix = split_match.group(1)
        total_parts = int(split_match.group(3))
        print(f"Detected split GGUF model with {total_parts} parts.", file=sys.stderr)
        first_dest = None
        for p in range(1, total_parts + 1):
            part_str = f"{p:05d}"
            part_rel_path = f"{prefix}-{part_str}-of-{total_parts:05d}.gguf"
            dest = download_file(repo, part_rel_path)
            if p == 1:
                first_dest = dest

        # Multi-part GGUFs are frequently too large for one card — check and hint.
        try:
            total_gb = sum(os.path.getsize(dest) for dest in
                           [first_dest] + [MODEL_DIR / f"{prefix}-{p:05d}-of-{total_parts:05d}.gguf"
                           for p in range(2, total_parts + 1)]) / 1e9
        except Exception:
            total_gb = 0
        largest_gb = 0
        for g in list_gpu_info():
            largest_gb = max(largest_gb, g["total_mib"] / 1024)
        print(f"Total model size: {total_gb:.1f} GB", file=sys.stderr)
        if total_gb > 0 and largest_gb and total_gb > largest_gb * 0.95:
            print(f"NOTE: model ({total_gb:.1f} GB) exceeds a single GPU ({largest_gb:.1f} GB).",
                  file=sys.stderr)
            print("Run `ai-backend gpus all` to spread it across every card (auto tensor-split).",
                  file=sys.stderr)
        return first_dest
    else:
        return download_file(repo, rel_path)

def apply_model_path(model_path):
    model_path = Path(model_path).resolve()
    if not model_path.exists():
        print(f"Model file not found: {model_path}", file=sys.stderr)
        sys.exit(1)

    kill_llama_server()
    
    if SYSTEMD_SERVICE.exists():
        try:
            content = SYSTEMD_SERVICE.read_text()
            new_content = re.sub(r'^Environment=LLAMA_MODEL_PATH=.*', f'Environment=LLAMA_MODEL_PATH={model_path}', content, flags=re.MULTILINE)
            SYSTEMD_SERVICE.write_text(new_content)
            subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
            print(f"Updated systemd service: LLAMA_MODEL_PATH={model_path}")
            if is_systemd_service_active():
                print("Restarting llama-server.service to apply new model...")
                subprocess.run(["systemctl", "--user", "restart", "llama-server.service"])
        except Exception as e:
            print(f"Warning updating systemd service: {e}", file=sys.stderr)

    write_env(f"http://localhost:{PORT}/v1/", "llama", str(model_path))
    print(f"Switched active backend to llama-server (http://localhost:{PORT}/v1/)")
    print(f"Active Model: {model_path}")

def kill_llama_server():
    if is_systemd_service_active():
        print("Stopping llama-server.service...")
        subprocess.run(["systemctl", "--user", "stop", "llama-server.service"], capture_output=True)
    try:
        res = subprocess.run(["pgrep", "-f", "llama-server.*--model"], capture_output=True, text=True)
        pids = res.stdout.strip().split()
        for pid in pids:
            print(f"Stopping running llama-server (PID {pid})...")
            subprocess.run(["kill", pid], capture_output=True)
    except Exception:
        pass

def is_systemd_service_active():
    try:
        res = subprocess.run(["systemctl", "--user", "is-active", "llama-server.service"], capture_output=True, text=True)
        return res.stdout.strip() == "active"
    except Exception:
        return False

def calculate_auto_ctx(model_path, vram_free=None, n_gpu_layers="99", gpu_indices=None, use_mtp=False):
    ram_free = 0
    try:
        with open("/proc/meminfo", "r") as f:
            for line in f:
                if line.startswith("MemAvailable:"):
                    ram_free = int(line.split()[1]) // 1024
                    break
    except Exception:
        pass

    if vram_free is None:
        vram_free = 0
        if gpu_indices:
            by_idx = {g["index"]: g for g in list_gpu_info()}
            vram_free = sum(by_idx.get(i, {}).get("free_mib", 0) for i in gpu_indices)
        elif shutil.which("nvidia-smi"):
            try:
                res = subprocess.run(
                    ["nvidia-smi", "--query-gpu=memory.free", "--format=csv,noheader,nounits"],
                    capture_output=True, text=True, timeout=5,
                )
                vram_free = int(res.stdout.splitlines()[0].strip())
            except Exception:
                pass

    try:
        model_mb = split_total_size(model_path) * 1024
    except Exception:
        model_mb = 4096

    factor = float(os.environ.get("LLAMA_CTX_SIZE_FACTOR", "1.0"))
    env_vars = load_env()
    rope_scaling = (os.environ.get("LLAMA_ROPE_SCALING") or env_vars.get("LLAMA_ROPE_SCALING", "")).strip().lower()
    rope_scale = os.environ.get("LLAMA_ROPE_SCALE") or env_vars.get("LLAMA_ROPE_SCALE", "")
    yarn_orig = os.environ.get("LLAMA_YARN_ORIG_CTX") or env_vars.get("LLAMA_YARN_ORIG_CTX", "262144")
    if rope_scaling == "yarn" and rope_scale:
        try:
            default_max = int(int(yarn_orig) * float(rope_scale))
        except (ValueError, TypeError):
            default_max = 262144 * 4
    else:
        default_max = 262144
    ctx_max = int(os.environ.get("LLAMA_CTX_SIZE_MAX", env_vars.get("LLAMA_CTX_SIZE_MAX", str(default_max))))

    # KV spill into CPU RAM only happens when some layers live on the CPU
    # (partial offload) — with every layer on the GPU the whole KV cache is GPU-resident.
    layers = (read_gguf_arch(model_path) or {}).get("layers")
    try:
        partial_offload = int(str(n_gpu_layers)) < (layers or 10**9)
    except (TypeError, ValueError):
        partial_offload = False
    if vram_free <= 0:
        partial_offload = True  # no GPU info at all → CPU-only, KV lives in RAM

    est = estimate_vram_mb(model_path, 0, use_mtp=use_mtp)  # base: weights + SSM state + overhead, no KV
    if est:
        base_mb = est["total_mb"]
        kv_gpu = max(est.get("kv_per_tok_mib", 0.01518), 0.001)
        kv_ram = 0.00400
    else:
        base_mb = model_mb * 0.703 + 3072  # legacy heuristic + flat overhead
        kv_gpu = 0.01518
        kv_ram = 0.00400

    safety_gpu = 2048
    safety_ram = 4096

    gpu_budget = max(0, vram_free - base_mb - safety_gpu)
    ctx_gpu_only = int(gpu_budget / kv_gpu)

    ram_budget = max(0, ram_free - safety_ram) if partial_offload else 0
    ctx_ram_extend = int(ram_budget / kv_ram) if partial_offload else 0

    ctx_base = min(ctx_max, ctx_gpu_only + ctx_ram_extend)
    ctx = int(ctx_base * factor)
    ctx = min(ctx_max, max(4096, (ctx // 512) * 512))

    source = "GPU" if ctx <= ctx_gpu_only else "GPU+RAM"
    if source == "GPU+RAM":
        print(f"[llama-wrapper] GPU-only fits {ctx_gpu_only} tokens — extending to {ctx} via CPU RAM KV offload", file=sys.stderr)
    print(f"[llama-wrapper] Auto ctx: {ctx} [{source}] (GPU free: {vram_free} MiB, RAM free: {ram_free} MiB, factor: {factor})", file=sys.stderr)
    return ctx

def list_gpu_info():
    """Return [{index, name, total_mib, free_mib}, ...] from nvidia-smi (empty if unavailable)."""
    gpus = []
    if not shutil.which("nvidia-smi"):
        return gpus
    try:
        res = subprocess.run(
            ["nvidia-smi", "--query-gpu=index,name,memory.total,memory.free",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=5,
        )
        for line in res.stdout.splitlines():
            parts = [p.strip() for p in line.split(",")]
            if len(parts) >= 4:
                gpus.append({"index": int(parts[0]), "name": parts[1],
                             "total_mib": int(parts[2]), "free_mib": int(parts[3])})
    except Exception:
        pass
    return gpus

def parse_gpu_sel(sel):
    """Turn a gpu selection string into a list of CUDA indices.
    'all' -> every detected GPU; '0,1' -> [0,1]; '1' -> [1]; None -> None."""
    if sel is None:
        return None
    s = str(sel).strip().lower().replace("gpu", "").replace(" ", "")
    if s in ("all", "*"):
        gpus = list_gpu_info()
        return [g["index"] for g in gpus] if gpus else None
    if s == "":
        return None
    idxs = []
    for part in s.split(","):
        if part == "":
            continue
        try:
            idxs.append(int(part))
        except ValueError:
            return None
    return idxs or None

def best_single_gpu_idx():
    """Index of the detected GPU with the most total VRAM, else '0'.

    Used to co-locate a speculative draft with the main model on one card
    (the draft can't be tensor-split). The serve-time default is
    `default_gpu_selection`, which falls back to every card for a model too
    big for the single largest one.
    """
    gpus = list_gpu_info()
    if not gpus:
        return "0"
    return str(max(gpus, key=lambda g: g["total_mib"])["index"])

def default_gpu_selection():
    """Auto: single largest GPU if it holds the active model, else all detected GPUs."""
    env_vars = load_env()
    model_path = os.environ.get("LLAMA_MODEL_PATH") or env_vars.get("LLAMA_MODEL_PATH")
    gpus = list_gpu_info()
    if not gpus:
        return "0"
    best = max(gpus, key=lambda g: g["total_mib"])
    if model_path and os.path.exists(model_path):
        model_gb = split_total_size(model_path)
        # Weights must fully fit on the single card (with a small safety margin).
        if model_gb > 0 and model_gb > (best["free_mib"] / 1024) * 0.95:
            idxs = sorted(g["index"] for g in gpus)
            return ",".join(str(i) for i in idxs)
    return str(best["index"])

def resolve_serve_gpu(need_single_card=False):
    """Resolve which GPU(s) `serve` runs on.

    Precedence:
      1. An explicit user pin — `CUDA_VISIBLE_DEVICES` in the process env or the
         env file (e.g. `ai-backend gpus 0` / `gpus 0,2` / `gpus all`) is honored
         verbatim.
      2. No pin (absent or the "auto" sentinel) -> the single biggest card (most
         VRAM) that holds the active model; if the model's weights don't fit the
         largest single card, every detected card is used (tensor-split). This is
         the "biggest card by default" behaviour — no stale pin is needed to steer it.

    `need_single_card` forces the single biggest card regardless of fit: a
    speculative draft (dspark/MTP) must co-locate with the main model on one GPU
    and cannot be tensor-split.
    """
    env_vars = load_env()
    explicit = os.environ.get("CUDA_VISIBLE_DEVICES") or env_vars.get("CUDA_VISIBLE_DEVICES")
    if explicit and explicit.strip() and explicit.strip() != "auto":
        return explicit.strip()
    if need_single_card:
        return best_single_gpu_idx()
    return default_gpu_selection()

def split_total_size(file_path):
    """Total size in GB of a GGUF, summing sibling '-NNNNN-of-MMNNN.gguf' parts.
    Falls back to the file's own size when it isn't part of a split."""
    p = Path(file_path)
    m = re.search(r'^(.*?)-(\d{5})-of-(\d{5})\.gguf$', p.name)
    if not m:
        try:
            return os.path.getsize(p) / 1e9
        except Exception:
            return 0
    prefix, part, total = m.group(1), int(m.group(2)), int(m.group(3))
    total_bytes = 0
    for i in range(1, total + 1):
        sibling = p.parent / f"{prefix}-{i:05d}-of-{total:05d}.gguf"
        if sibling.exists():
            total_bytes += os.path.getsize(sibling)
    return total_bytes / 1e9

def compute_tensor_split(gpu_indices, ctx_reserve=2048):
    """Proportional --tensor-split string across GPUs by (free VRAM - reserve).
    Returns None unless 2+ GPUs. NOTE: tensor-split is weights split, so the
    biggest GPU takes proportionally more layers."""
    if not gpu_indices or len(gpu_indices) < 2:
        return None
    by_idx = {g["index"]: g for g in list_gpu_info()}
    frees = []
    for i in gpu_indices:
        free = by_idx.get(i, {}).get("free_mib", 0)
        frees.append(max(0, free - ctx_reserve))
    total = sum(frees)
    if total <= 0:
        return ",".join(["1.0"] + ["0.0"] * (len(frees) - 1))
    props = [f / total for f in frees]
    return ",".join(f"{p:.3f}" for p in props)

def read_gguf_arch(path):
    """Key architecture fields from a GGUF header, else None.

    Returns {"arch", "layers", "kv_heads", "head_dim", "full_attn_interval",
    "nextn"} — enough to size the KV cache (and SSM state for hybrid models)
    from first principles instead of a one-size-fits-all per-token guess.
    Uses gguf-py when importable (site-packages or the llama.cpp repo copy).
    """
    _gg = None
    try:
        import gguf as _gg
    except Exception:
        pass
    if _gg is None:
        for cand in (
            str(Path.home() / ".local" / "share" / "ai" / "llama.cpp" / "gguf-py"),
            str(Path.home() / "Code" / "llama.cpp" / "gguf-py"),
            "/home/dzyla/Code/llama.cpp/gguf-py",
        ):
            if os.path.isdir(cand):
                sys.path.insert(0, cand)
                try:
                    import gguf as _gg
                    break
                except Exception:
                    _gg = None
    if _gg is None:
        return None
    try:
        r = _gg.GGUFReader(str(path))
        vals = {}
        for f in r.fields.values():
            n = f.name
            if n == "general.architecture":
                try:
                    vals["arch"] = str(f.contents())
                except Exception:
                    pass
                continue
            if "." not in n:
                continue
            base, key = n.rsplit(".", 1)
            if key in ("block_count", "head_count_kv", "head_dim", "key_length",
                       "value_length", "full_attention_interval", "nextn_predict_layers",
                       "state_size", "inner_size", "group_count", "conv_kernel",
                       "time_step_rank"):
                try:
                    vals.setdefault(base, {})[key] = f.contents()
                except Exception:
                    pass
        arch = vals.get("arch")
        if not arch:
            return None
        # Architecture fields may be split across nested namespaces (e.g.
        # "qwen35.attention.*" / "qwen35.ssm.*") — merge them all into one dict.
        a = dict(vals.get(arch, {}))
        for ns, fields in vals.items():
            if ns.startswith(arch + ".") and isinstance(fields, dict):
                a.update(fields)
        layers = a.get("block_count")
        if not layers:
            return None
        kv_heads = a.get("head_count_kv") or 0
        head_dim = a.get("head_dim") or a.get("key_length") or 0
        ssm = None
        if "state_size" in a and "inner_size" in a and "group_count" in a:
            ssm = {
                "state": int(a["state_size"]),
                "inner": int(a["inner_size"]),
                "groups": int(a["group_count"]),
                "conv": int(a.get("conv_kernel") or 4),
                "dtime": int(a.get("time_step_rank") or 0),
            }
        return {
            "arch": arch,
            "layers": int(layers),
            "kv_heads": int(kv_heads),
            "head_dim": int(head_dim),
            "full_attn_interval": int(a.get("full_attention_interval") or 1),
            "nextn": int(a.get("nextn_predict_layers") or 0),
            "ssm": ssm,
        }
    except Exception:
        return None

def estimate_vram_mb(model_path, ctx, use_mtp=False):
    """Rough GPU-VRAM footprint (MiB) of running `model_path` at `ctx` tokens.

    Covers weights (file size, +~5% for descaled compute copies), the fixed
    recurrent state of hybrid/SSM layers (Mamba-style state + conv, ~1 GiB for
    Qwen3.8-27B), a flat 3 GB overhead (graphs, buffers, compute buffers,
    flash-attn scratch), and the q8_0 KV cache of the full-attention layers
    (for hybrid models only a fraction of layers carry full attention).
    Returns None when the GGUF header can't be read — callers should fall back
    to the legacy heuristic. Also reports kv_per_tok_mib for per-token sizing.
    """
    arch = read_gguf_arch(model_path)
    try:
        weights_mb = split_total_size(model_path) * 1024
    except Exception:
        return None
    if not arch or not arch["layers"]:
        return None
    layers = arch["layers"]
    n_full = (layers + arch["full_attn_interval"] - 1) // arch["full_attn_interval"]
    kv_heads = arch["kv_heads"]
    head_dim = arch["head_dim"]
    kv_per_tok_mb = 2 * max(kv_heads, 1) * max(head_dim, 1) * 1.03 * n_full / (1024 * 1024)  # q8_0 K+V, MiB/tok
    total = weights_mb * 1.05 + 3072  # weights + flat overhead
    ssm = arch.get("ssm")
    if ssm:
        # Per SSM layer: a state matrix [groups, inner, state] (fp16) plus a
        # conv buffer [groups, inner, conv] (fp16). No token dependence.
        per_layer = 2 * ssm["groups"] * ssm["inner"] * (ssm["state"] + ssm["conv"])
        total += per_layer * layers / (1024 * 1024)
    if use_mtp and arch.get("nextn"):
        # MTP head: small extra weights + its own KV slot per token.
        total += weights_mb * 0.08
        kv_per_tok_mb *= 1.03
    return {
        "total_mb": int(total + kv_per_tok_mb * ctx),
        "kv_per_tok_mib": kv_per_tok_mb,
        "weights_mb": int(weights_mb),
        "layers": layers,
    }

def vram_preflight(model_path, ctx_size, gpu_indices, n_gpu="99", use_mtp=False, n_cpu_moe=0):
    """Pre-flight VRAM check before spawning llama-server.

    Prints a warning (returns True) and lets the launch proceed when the model
    looks like it fits; prints an actionable error and returns False — callers
    must abort — when it clearly cannot fit. Configs that legitimately spill
    into system RAM (partial offload: n-gpu-layers < model layers, or MoE
    experts kept in CPU RAM via --n-cpu-moe) are only warned about, never
    hard-blocked.
    """
    est = estimate_vram_mb(model_path, ctx_size, use_mtp=use_mtp)
    if not est:
        print("[llama-wrapper] NOTE: could not estimate VRAM footprint (GGUF unreadable?) — skipping pre-flight check.", file=sys.stderr)
        return True
    by_idx = {g["index"]: g for g in list_gpu_info()}
    free = [by_idx.get(i, {}).get("free_mib", 0) for i in (gpu_indices or [])]
    if not free or not any(free):
        print("[llama-wrapper] NOTE: no nvidia-smi VRAM info — skipping pre-flight check.", file=sys.stderr)
        return True
    free_total = sum(f for f in free if f > 0)
    needed = est["total_mb"]
    layers = est.get("layers")
    partial = False
    try:
        partial = int(str(n_gpu)) < (layers or 10**9)
    except (TypeError, ValueError):
        pass
    if partial or n_cpu_moe > 0:
        why = f"partial offload (-ngl {n_gpu} < {layers} layers)" if partial else f"--n-cpu-moe {n_cpu_moe} experts in CPU RAM"
        print(f"[llama-wrapper] NOTE: {why} — VRAM check relaxed (some state lives in system RAM).", file=sys.stderr)
        return True
    overage = needed - free_total
    if overage <= max(2048, needed * 0.02):
        return True
    single = len(gpu_indices or []) == 1
    sel = ",".join(str(i) for i in (gpu_indices or []))
    cards = [by_idx.get(i, {}).get("name", f"GPU{i}") for i in (gpu_indices or [])]
    print(f"[llama-wrapper] ERROR: model will not fit in VRAM.", file=sys.stderr)
    print(f"[llama-wrapper]   model:        {os.path.basename(str(model_path))}", file=sys.stderr)
    print(f"[llama-wrapper]   estimated:    {needed / 1024:.1f} GiB (weights {est['weights_mb'] / 1024:.1f} + KV/state + overhead) at ctx {ctx_size}" + (f" + MTP" if use_mtp else ""), file=sys.stderr)
    print(f"[llama-wrapper]   available:    {free_total / 1024:.1f} GiB free on {sel} ({' + '.join(cards)})", file=sys.stderr)
    print(f"[llama-wrapper]   short by:     ~{overage / 1024:.1f} GiB", file=sys.stderr)
    print(f"[llama-wrapper] Fixes (pick one):", file=sys.stderr)
    if not single:
        print(f"[llama-wrapper]   - use a bigger single card:  ai-backend gpus 1   (or: CUDA_VISIBLE_DEVICES=1 ai-backend serve)", file=sys.stderr)
    if use_mtp:
        print(f"[llama-wrapper]   - drop MTP speculative decode: ai-backend mtp off", file=sys.stderr)
    auto_ctx = max(4096, int((free_total - est['weights_mb'] * 1.05 - 5120) / max(est['kv_per_tok_mib'], 0.001)) // 512 * 512)
    print(f"[llama-wrapper]   - lower the context:           ai-backend ctx {min(auto_ctx, 262144)}   (or ai-backend ctx auto to size it from free VRAM)", file=sys.stderr)
    if single:
        print(f"[llama-wrapper]   - or spread across cards:       ai-backend gpus all", file=sys.stderr)
    print(f"[llama-wrapper] Aborting before launching llama-server (it would have OOM'd mid-load).", file=sys.stderr)
    return False

def read_gguf_block_count(path):
    """Number of transformer layers (block_count) from a GGUF header, else None.
    Uses gguf-py when importable (installed or the llama.cpp repo copy)."""
    _gg = None
    try:
        import gguf as _gg
    except Exception:
        pass
    if _gg is None:
        for cand in (
            str(Path.home() / "Code" / "llama.cpp" / "gguf-py"),
            "/home/dzyla/Code/llama.cpp/gguf-py",
        ):
            if os.path.isdir(cand):
                sys.path.insert(0, cand)
                try:
                    import gguf as _gg
                    break
                except Exception:
                    _gg = None
    if _gg is None:
        return None
    try:
        r = _gg.GGUFReader(str(path))
        for f in r.fields.values():
            if f.name.endswith(".block_count"):
                return int(f.contents())
    except Exception:
        pass
    return None


def is_deepseek_model(model_path):
    """True when the model belongs to the DeepSeek family — the only model
    family the dspark draft / dsv4 speculative-decode path supports."""
    return "deepseek" in os.path.basename(str(model_path)).lower()


def is_qwen38_model(model_path):
    """True when the model belongs to the Qwen3.8 family."""
    name = os.path.basename(str(model_path)).lower()
    return "qwen3.8" in name or "qwen3_8" in name or "qwen-3.8" in name or "qwen38" in name


def is_qwen_model(model_path):
    """True when the model belongs to the Qwen family."""
    return "qwen" in os.path.basename(str(model_path)).lower()


def find_dspark_draft(main_path=None):
    """Locate a DeepSeek dspark draft model for the active main model.

    The dspark draft is DeepSeek V4-specific and MUST only be attached to a
    DeepSeek main model: llama.cpp aborts building the dsv4 graph against any
    other architecture (e.g. a dense model like BigBang). So this returns None
    whenever the main model is not DeepSeek, even if a draft path is configured.

    Check order: explicit LLAMA_DRAFT_MODEL_PATH -> sibling in the model dir ->
    any dspark-*.gguf in the models dir. Returns path or None.
    """
    env_vars = load_env()
    if not main_path:
        main_path = os.environ.get("LLAMA_MODEL_PATH") or env_vars.get("LLAMA_MODEL_PATH")
    if not main_path or not is_deepseek_model(main_path):
        return None
    d = os.environ.get("LLAMA_DRAFT_MODEL_PATH") or env_vars.get("LLAMA_DRAFT_MODEL_PATH")
    if d and os.path.exists(d):
        return d
    if main_path:
        try:
            for f in sorted(os.listdir(os.path.dirname(os.path.abspath(str(main_path))))):
                if "dspark" in f.lower() and f.endswith(".gguf"):
                    return os.path.join(os.path.dirname(os.path.abspath(str(main_path))), f)
        except Exception:
            pass
    if MODEL_DIR.exists():
        for p in sorted(MODEL_DIR.iterdir()):
            if p.suffix == ".gguf" and "dspark" in p.name.lower():
                return str(p)
    return None


def find_mtp_draft(main_path=None):
    """Locate an MTP draft model for the active main model if separate.
    Check order: explicit LLAMA_MTP_DRAFT_PATH / LLAMA_DRAFT_MODEL_PATH ->
    sibling MTP GGUF (matching model prefix)."""
    env_vars = load_env()
    if not main_path:
        main_path = os.environ.get("LLAMA_MODEL_PATH") or env_vars.get("LLAMA_MODEL_PATH")
    if not main_path:
        return None
    d = os.environ.get("LLAMA_MTP_DRAFT_PATH") or os.environ.get("LLAMA_DRAFT_MODEL_PATH") or env_vars.get("LLAMA_DRAFT_MODEL_PATH")
    if d and os.path.exists(d) and "mtp" in os.path.basename(d).lower():
        return d

    main_base = os.path.basename(str(main_path)).lower()
    prefix = main_base.split("-")[0] if "-" in main_base else main_base.split(".")[0]

    candidates = []
    if main_path:
        main_dir = os.path.dirname(os.path.abspath(str(main_path)))
        try:
            for f in sorted(os.listdir(main_dir)):
                if "mtp" in f.lower() and f.endswith(".gguf") and f.lower() != main_base:
                    candidates.append(os.path.join(main_dir, f))
        except Exception:
            pass
    if MODEL_DIR.exists() and (not main_path or str(MODEL_DIR) != os.path.dirname(os.path.abspath(str(main_path)))):
        for p in sorted(MODEL_DIR.iterdir()):
            if p.suffix == ".gguf" and "mtp" in p.name.lower() and p.name.lower() != main_base:
                candidates.append(str(p))

    for cand in candidates:
        cand_base = os.path.basename(cand).lower()
        if prefix and len(prefix) >= 3 and prefix in cand_base:
            return cand
    return None


def compute_main_ngl_for_draft(main_path, draft_path, vram_free_mib):
    """Main-model -ngl that leaves the draft VRAM room to load fully on GPU.
    Plain -ngl auto is unsafe here: llama.cpp fills the GPU with the main model and
    the draft then OOMs. So reserve enough for the draft plus compute/KV buffers and
    offload the rest of the main model to GPU."""
    try:
        draft_mib = os.path.getsize(draft_path) // (1024 * 1024)
    except Exception:
        draft_mib = 1
    main_gb = split_total_size(main_path)
    blk = read_gguf_block_count(main_path) or 32
    per_layer = (main_gb * 1024) / blk
    if per_layer <= 0:
        return None
    reserve = 4096  # main compute buffer + KV + safety
    avail = max(0, (vram_free_mib or 0) - draft_mib - reserve)
    ngl = int(avail / per_layer) if per_layer > 0 else 0
    return max(1, min(ngl, blk))


def restart_systemd_service(verbose=True):
    """Automatically reloads daemon and restarts/resets llama-server when backend settings change."""
    try:
        subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
        if is_systemd_service_active():
            subprocess.run(["systemctl", "--user", "restart", "llama-server.service"], capture_output=True)
            if verbose:
                print("[ai-backend] Automatically restarted llama-server.service with updated settings.")
        else:
            subprocess.run(["systemctl", "--user", "restart", "llama-server.socket"], capture_output=True)
    except Exception as e:
        if verbose:
            print(f"[ai-backend] Notice syncing systemd: {e}", file=sys.stderr)

def persist_env_changes(changes, auto_restart=True):
    """Apply {key: value} changes to ~/.local/share/ai/env preserving the rest.
    value None removes the key (auto). Automatically reloads & restarts systemd service."""
    env_vars = load_env()
    for k, v in changes.items():
        if v is None:
            env_vars.pop(k, None)
        else:
            env_vars[k] = v
    url = env_vars.get("INFER_BASE_URL", f"http://localhost:{PORT}/v1/")
    model = env_vars.get("INFER_MODEL", "llama")
    llama_path = env_vars.get("LLAMA_MODEL_PATH")
    # Pass the full merged state (deletions applied) as authoritative so
    # write_env does not re-merge the on-disk copy and resurrect deleted keys.
    write_env(url, model, llama_path, env_vars, authoritative=True)
    if auto_restart:
        restart_systemd_service()

def sync_gpu_to_systemd(cuda_dev):
    """Keep the systemd unit's CUDA_VISIBLE_DEVICES in sync with the env file.

    A concrete selection ('1', '0,2', 'all', ...) pins the unit to those card(s).
    The 'auto' sentinel means "serve picks the biggest card at startup", so the
    pin is removed from the unit — leaving it pinned would force a specific card
    and defeat the biggest-card default (e.g. a stale pin to a small card).
    """
    if not SYSTEMD_SERVICE.exists():
        return
    try:
        content = SYSTEMD_SERVICE.read_text()
        if cuda_dev in (None, "", "auto"):
            new_content = re.sub(
                r'^Environment=CUDA_VISIBLE_DEVICES=.*\n?',
                '',
                content, flags=re.MULTILINE,
            )
        else:
            if re.search(r'^Environment=CUDA_VISIBLE_DEVICES=', content, flags=re.MULTILINE):
                new_content = re.sub(
                    r'^Environment=CUDA_VISIBLE_DEVICES=.*',
                    f'Environment=CUDA_VISIBLE_DEVICES={cuda_dev}',
                    content, flags=re.MULTILINE,
                )
            else:
                # No existing pin: insert one right after the [Service] section.
                new_content = re.sub(
                    r'^\[Service\]\n',
                    f'[Service]\nEnvironment=CUDA_VISIBLE_DEVICES={cuda_dev}\n',
                    content, flags=re.MULTILINE,
                )
        if new_content != content:
            SYSTEMD_SERVICE.write_text(new_content)
            subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
            if cuda_dev in (None, "", "auto"):
                print("[ai-backend] Cleared systemd GPU pin — serve will auto-select the biggest card.")
            else:
                print(f"[ai-backend] Synced systemd CUDA_VISIBLE_DEVICES={cuda_dev}")
    except Exception as e:
        print(f"Warning syncing systemd GPU config: {e}", file=sys.stderr)

def cmd_serve():
    env_vars = load_env()
    model_path = os.environ.get("LLAMA_MODEL_PATH") or env_vars.get("LLAMA_MODEL_PATH")
    if not model_path or not os.path.exists(model_path):
        print(f"Error: LLAMA_MODEL_PATH not found or invalid: {model_path}", file=sys.stderr)
        sys.exit(1)

    idle_timeout = int(os.environ.get("LLAMA_IDLE_TIMEOUT", env_vars.get("LLAMA_IDLE_TIMEOUT", "120")))
    ctx_override = os.environ.get("LLAMA_CTX_SIZE", env_vars.get("LLAMA_CTX_SIZE"))

    # Draft / speculative decoding: decided up front because it changes both the
    # GPU choice (a draft must co-locate with the main model on one card) and the
    # ctx sizing (MTP adds state).
    draft_path = find_dspark_draft(model_path)
    mtp_draft_path = find_mtp_draft(model_path)
    use_mtp = (
        os.environ.get("LLAMA_MTP") in ("1", "true", "on")
        or env_vars.get("LLAMA_MTP") in ("1", "true", "on")
        or "mtp" in os.path.basename(model_path).lower()
        or (mtp_draft_path is not None)
    )

    if not draft_path:
        # A dspark draft was configured but the active model isn't DeepSeek, so
        # it will be (correctly) ignored. Surface this so it's not puzzling why
        # speculative decoding is off.
        legacy_draft = os.environ.get("LLAMA_DRAFT_MODEL_PATH") or env_vars.get("LLAMA_DRAFT_MODEL_PATH")
        if legacy_draft and not is_deepseek_model(model_path) and "mtp" not in legacy_draft.lower():
            print(f"[llama-wrapper] NOTE: LLAMA_DRAFT_MODEL_PATH is set ({legacy_draft}) but the active "
                  f"model ({os.path.basename(model_path)}) is not DeepSeek — ignoring the dspark draft "
                  f"(it is DeepSeek V4-specific). Run `ai-backend draft off` to clear it.", file=sys.stderr)

    # Resolve which GPUs to use. An explicit pin (process env or `ai-backend gpus
    # ...` in the env file) is honored verbatim; otherwise serve defaults to the
    # single biggest card that holds the active model, or every card (tensor-split)
    # when no single card fits the weights.
    if draft_path or mtp_draft_path:
        # A speculative draft (dspark/MTP) must co-locate with the main model on
        # ONE card — it can't be tensor-split — so no pin means the biggest card.
        cuda_dev = resolve_serve_gpu(need_single_card=True)
    else:
        cuda_dev = resolve_serve_gpu()
    gpu_indices = parse_gpu_sel(cuda_dev)
    os.environ["CUDA_VISIBLE_DEVICES"] = cuda_dev
    print(f"[llama-wrapper] Using CUDA_VISIBLE_DEVICES={cuda_dev} "
          f"({len(gpu_indices or [])} GPU{'s' if len(gpu_indices or []) != 1 else ''})",
          file=sys.stderr)

    # Aggregate free VRAM across all selected GPUs (KV cache spreads across them).
    agg_vram_free = 0
    by_idx = {g["index"]: g for g in list_gpu_info()}
    for i in (gpu_indices or []):
        agg_vram_free += by_idx.get(i, {}).get("free_mib", 0)

    if ctx_override:
        ctx_size = int(ctx_override)
        print(f"[llama-wrapper] Using explicit ctx: {ctx_size}", file=sys.stderr)
    else:
        ctx_size = calculate_auto_ctx(
            model_path, vram_free=agg_vram_free or None,
            n_gpu_layers=os.environ.get("LLAMA_N_GPU_LAYERS", env_vars.get("LLAMA_N_GPU_LAYERS", "99")),
            gpu_indices=gpu_indices, use_mtp=use_mtp,
        )

    extra_args = []

    if use_mtp:
        spec_type = os.environ.get("LLAMA_SPEC_TYPE", env_vars.get("LLAMA_SPEC_TYPE", "draft-mtp"))
        spec_draft_n_max = os.environ.get("LLAMA_SPEC_DRAFT_N_MAX", env_vars.get("LLAMA_SPEC_DRAFT_N_MAX", "3"))
        extra_args.extend(["--spec-type", spec_type, "--spec-draft-n-max", str(spec_draft_n_max)])
        if mtp_draft_path:
            extra_args.extend(["-md", mtp_draft_path])
            print(f"[llama-wrapper] Enabling Multi-Token Prediction (MTP) with draft {os.path.basename(mtp_draft_path)} (spec-type={spec_type}, draft-n-max={spec_draft_n_max}).", file=sys.stderr)
        else:
            print(f"[llama-wrapper] Enabling Multi-Token Prediction (MTP) speculative decoding (spec-type={spec_type}, draft-n-max={spec_draft_n_max}).", file=sys.stderr)
        # The built-in MTP draft context is created with n_seq_max=1, so the
        # recipe (sudoingX/qwen38-mtp) pins --parallel 1. Respect an explicit
        # LLAMA_N_PARALLEL override, otherwise pin 1 while MTP is active.
        n_parallel = os.environ.get("LLAMA_N_PARALLEL", env_vars.get("LLAMA_N_PARALLEL", ""))
        if n_parallel:
            extra_args.extend(["--parallel", str(n_parallel)])
        else:
            extra_args.extend(["--parallel", "1"])
            print("[llama-wrapper] MTP active: pinning --parallel 1 (single slot; the MTP draft context is single-sequence). Set LLAMA_N_PARALLEL to override.", file=sys.stderr)

    # Reasoning models (DeepSeek V4, Qwen 3.8, Qwen 3.6, etc.) need the chat template + reasoning
    # handling enabled, else chat completions degenerate into raw CoT garbage.
    extra_args.extend(["--jinja", "--reasoning", "on"])

    # Server-level sampling penalties (llama.cpp style). Applied to ALL requests.
    # --repeat-penalty is a multiplier (1.0 = neutral), rest are additive (0.0 = neutral).
    # For Qwen 3.8 (and similar models), default penalties should be neutral (repeat=1.0, presence=0.0).
    repeat_penalty = os.environ.get("LLAMA_REPEAT_PENALTY", env_vars.get("LLAMA_REPEAT_PENALTY", "1.0"))
    presence_penalty = os.environ.get("LLAMA_PRESENCE_PENALTY", env_vars.get("LLAMA_PRESENCE_PENALTY", "0.0"))
    frequency_penalty = os.environ.get("LLAMA_FREQUENCY_PENALTY", env_vars.get("LLAMA_FREQUENCY_PENALTY", "0.0"))
    repeat_last_n = os.environ.get("LLAMA_REPEAT_LAST_N", env_vars.get("LLAMA_REPEAT_LAST_N", "64"))
    
    extra_args.extend([
        "--repeat-penalty", str(repeat_penalty),
        "--repeat-last-n", str(repeat_last_n),
        "--presence-penalty", str(presence_penalty),
        "--frequency-penalty", str(frequency_penalty),
    ])
    print(f"[llama-wrapper] Server penalties: repeat={repeat_penalty} presence={presence_penalty} frequency={frequency_penalty} repeat_last_n={repeat_last_n}", file=sys.stderr)
    
    # YaRN RoPE scaling: expand the context window beyond the model's native
    # training length (e.g. Qwen3.8-27B 262144 -> ~1M at scale 4). Set via
    # `ai-backend yarn`. llama.cpp auto-derives the other YaRN knobs (ext-factor,
    # attn-factor, beta-slow/fast) from scale + orig-ctx, so only these three are
    # needed. Only emitted when the user has opted in.
    rope_scaling = os.environ.get("LLAMA_ROPE_SCALING") or env_vars.get("LLAMA_ROPE_SCALING", "")
    rope_scale = os.environ.get("LLAMA_ROPE_SCALE") or env_vars.get("LLAMA_ROPE_SCALE", "")
    yarn_orig = os.environ.get("LLAMA_YARN_ORIG_CTX") or env_vars.get("LLAMA_YARN_ORIG_CTX", "")
    if rope_scaling and rope_scaling.strip() and rope_scale:
        extra_args.extend(["--rope-scaling", rope_scaling.strip()])
        extra_args.extend(["--rope-scale", str(rope_scale)])
        if yarn_orig and yarn_orig.strip():
            extra_args.extend(["--yarn-orig-ctx", str(int(yarn_orig))])
        print(f"[llama-wrapper] YaRN: --rope-scaling {rope_scaling} --rope-scale {rope_scale} --yarn-orig-ctx {yarn_orig or '(auto)'}", file=sys.stderr)

    n_gpu = os.environ.get("LLAMA_N_GPU_LAYERS", env_vars.get("LLAMA_N_GPU_LAYERS", "99"))

    # DeepSeek V4 Flash dspark draft: wire the draft model into speculative decoding.
    if draft_path:
        n_cpu_moe_active = int(os.environ.get("LLAMA_N_CPU_MOE", env_vars.get("LLAMA_N_CPU_MOE", "0"))) > 0
        n_glx = os.environ.get("LLAMA_N_GPU_LAYERS") or env_vars.get("LLAMA_N_GPU_LAYERS")
        if not n_cpu_moe_active and (not n_glx or n_glx == "99"):
            computed = compute_main_ngl_for_draft(model_path, draft_path, agg_vram_free or None)
            if computed:
                n_gpu = str(computed)
                print(f"[llama-wrapper] Main -ngl capped to {computed} to reserve VRAM for dspark draft.",
                      file=sys.stderr)
        spec_draft_n_max = os.environ.get("LLAMA_SPEC_DRAFT_N_MAX", env_vars.get("LLAMA_SPEC_DRAFT_N_MAX", "3"))
        spec_draft_ngl = os.environ.get("LLAMA_N_GPU_LAYERS_DRAFT", env_vars.get("LLAMA_N_GPU_LAYERS_DRAFT", "99"))
        extra_args.extend([
            "-md", draft_path,
            "--spec-type", "draft-dspark",
            "--spec-draft-n-max", str(spec_draft_n_max),
            "--spec-draft-ngl", str(spec_draft_ngl),
        ])
        print(f"[llama-wrapper] dspark draft: {os.path.basename(draft_path)} "
              f"(spec-draft-n-max={spec_draft_n_max}, draft-ngl={spec_draft_ngl})",
              file=sys.stderr)

    # Multi-GPU tensor split: when 2+ cards are selected and the user hasn't pinned
    # an explicit split, apportion model weights across cards proportionally to each
    # card's free VRAM (biggest card carries the most layers).
    tensor_split = os.environ.get("LLAMA_TENSOR_SPLIT", env_vars.get("LLAMA_TENSOR_SPLIT"))
    if not tensor_split and gpu_indices and len(gpu_indices) > 1:
        tensor_split = compute_tensor_split(gpu_indices)
    if tensor_split:
        extra_args.extend(["--tensor-split", tensor_split])
        print(f"[llama-wrapper] Multi-GPU tensor-split: {tensor_split}", file=sys.stderr)
    elif gpu_indices and len(gpu_indices) == 1:
        print(f"[llama-wrapper] Single-GPU serving (GPU {gpu_indices[0]}).", file=sys.stderr)
    
    # KV cache type. Quantised (q8_0) cache keeps the KV cache small enough to
    # spread across GPUs — critical for large MoE models (e.g. DeepSeek V4 Flash)
    # where a fp16 KV cache gets pinned to one card and OOMs it. Overridable per
    # model via LLAMA_CACHE_TYPE_K / LLAMA_CACHE_TYPE_V.
    cache_type_k = os.environ.get("LLAMA_CACHE_TYPE_K", env_vars.get("LLAMA_CACHE_TYPE_K", "q8_0"))
    cache_type_v = os.environ.get("LLAMA_CACHE_TYPE_V", env_vars.get("LLAMA_CACHE_TYPE_V", "q8_0"))

    # DeepSeek V4 (and other reasoning MoE models): keep the MoE expert weights
    # of the FIRST N layers in CPU RAM instead of VRAM. For very large MoE models
    # this lets a single big GPU hold the ~full model while experts page from RAM,
    # avoiding the cross-GPU tensor-split that degenerates output. 0/absent = off.
    n_cpu_moe = int(os.environ.get("LLAMA_N_CPU_MOE", env_vars.get("LLAMA_N_CPU_MOE", "0")))
    if n_cpu_moe > 0:
        extra_args.extend(["--n-cpu-moe", str(n_cpu_moe)])
        print(f"[llama-wrapper] Keeping MoE experts of first {n_cpu_moe} layers in CPU RAM.", file=sys.stderr)

    batch_size = os.environ.get("LLAMA_BATCH_SIZE", env_vars.get("LLAMA_BATCH_SIZE", "4096"))
    ubatch_size = os.environ.get("LLAMA_UBATCH_SIZE", env_vars.get("LLAMA_UBATCH_SIZE", "2048"))
    threads_count = os.environ.get("LLAMA_THREADS", env_vars.get("LLAMA_THREADS", "16"))
    # Native llama-server idle-suspend: frees GPU VRAM after this many seconds of
    # no activity without killing the process (it resumes on next request).
    # Set to 90% of our Python-level idle_timeout so the server sleeps first,
    # then we terminate if it stays idle even longer.
    sleep_idle = max(30, idle_timeout - 30)

    # Pre-flight VRAM check: refuse to launch a server that cannot fit the
    # model + context (the old behaviour was an opaque mid-load cudaMalloc OOM).
    # Configs that spill to system RAM (partial offload / --n-cpu-moe) are relaxed.
    if not vram_preflight(model_path, ctx_size, gpu_indices, n_gpu=n_gpu, use_mtp=use_mtp, n_cpu_moe=n_cpu_moe):
        sys.exit(1)

    cmd = [
        "llama-server",
        "--model", model_path,
        "--host", "127.0.0.1",
        "--port", str(PORT),
        "--ctx-size", str(ctx_size),
        "--n-gpu-layers", str(n_gpu),
        "--flash-attn", "on",
        "--cache-type-k", cache_type_k,
        "--cache-type-v", cache_type_v,
        "--batch-size", str(batch_size),
        "--ubatch-size", str(ubatch_size),
        "--threads", str(threads_count),
        "--metrics",
        "--sleep-idle-seconds", str(sleep_idle),
    ] + extra_args
    
    print(f"[llama-wrapper] Starting llama-server — model: {os.path.basename(model_path)} ctx: {ctx_size}", file=sys.stderr)
    
    proc = subprocess.Popen(cmd)
    
    def cleanup(signum=None, frame=None):
        print(f"[llama-wrapper] Shutting down llama-server (PID {proc.pid})...", file=sys.stderr)
        try:
            proc.terminate()
            proc.wait(timeout=5)
        except Exception:
            try:
                proc.kill()
            except Exception:
                pass
        sys.exit(0)
        
    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)
    
    ready = False
    for _ in range(60):
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{PORT}/health", timeout=2) as resp:
                if resp.status == 200:
                    ready = True
                    break
        except Exception:
            pass
        time.sleep(1)
        
    if not ready:
        print("[llama-wrapper] Warning: Health check did not respond within 60s", file=sys.stderr)
    else:
        print(f"[llama-wrapper] Server ready. Monitoring idle (timeout: {idle_timeout}s)...", file=sys.stderr)
        
    last_seen = time.time()
    last_tokens = -1  # -1 = not yet initialised; avoids false-idle on first poll
    
    while proc.poll() is None:
        time.sleep(10)
        activity = False
        try:
            req = urllib.request.Request(f"http://127.0.0.1:{PORT}/metrics")
            with urllib.request.urlopen(req, timeout=3) as resp:
                content = resp.read().decode('utf-8', errors='ignore')
                prompt_tok = 0
                pred_tok = 0
                busy_conns = 0
                for line in content.splitlines():
                    if line.startswith("llamacpp:prompt_tokens_total "):
                        prompt_tok = int(float(line.split()[1]))
                    elif line.startswith("llamacpp:tokens_predicted_total "):
                        pred_tok = int(float(line.split()[1]))
                    elif line.startswith("llamacpp:requests_processing "):
                        busy_conns = int(float(line.split()[1]))
                tot = prompt_tok + pred_tok
                if last_tokens < 0:
                    # First poll after ready: seed the baseline, don't count as activity
                    last_tokens = tot
                elif tot > last_tokens:
                    # New tokens were generated since last check → genuinely active
                    activity = True
                    last_tokens = tot
                if not activity and busy_conns > 0:
                    activity = True  # request in flight right now
        except Exception:
            pass

        # Double-check via /slots for active generation (more reliable than metrics gauge)
        if not activity:
            try:
                req = urllib.request.Request(f"http://127.0.0.1:{PORT}/slots")
                with urllib.request.urlopen(req, timeout=2) as resp:
                    import json as _json
                    slots = _json.loads(resp.read())
                    # state 1 = generating, state 2 = processing prompt
                    if any(s.get("state", 0) in (1, 2) for s in slots):
                        activity = True
            except Exception:
                pass
            
        if activity:
            last_seen = time.time()
            
        idle = time.time() - last_seen
        if idle > idle_timeout:
            print(f"[llama-wrapper] Idle {int(idle)}s — stopping server.", file=sys.stderr)
            cleanup()
            
    sys.exit(proc.returncode or 0)

